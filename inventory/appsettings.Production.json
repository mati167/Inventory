{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "/var/log/nlog/internal-nlog.txt",
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "/var/log/api.log",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss} | ${level:uppercase=true} | ${logger} | ${message:withException=true}",
        "archiveFileName": "/var/log/api.${shortdate}.{##}.log",
        "archiveNumbering": "Rolling",
        "archiveEvery": "Day",
        "maxArchiveFiles": 30,
        "concurrentWrites": true,
        "keepFileOpen": false
      },
      "console": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss} | ${level:uppercase=true} | ${logger} | ${message}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logfile"
      },
      {
        "logger": "Microsoft.*",
        "minLevel": "Warning",
        "writeTo": "logfile",
        "final": true
      }
    ]
  },
  "AllowedHosts": "*",
  "ExternalApis": {
    "OMDb": {
      "BaseUrl": "https://www.omdbapi.com/"
    }
  }
}
