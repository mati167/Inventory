{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "/var/log/nlog/internal-nlog.txt",
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "/var/log/api.log",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss} | ${level:uppercase=true} | ${logger} | ${message:withException=true}",
        "archiveFileName": "/var/log/api.${shortdate}.{##}.log",
        "archiveNumbering": "Rolling",
        "archiveEvery": "Day",
        "maxArchiveFiles": 30,
        "concurrentWrites": true,
        "keepFileOpen": false
      },
      "console": {
        "type": "Console",
        "layout": "${date:format=yyyy-MM-dd HH\\:mm\\:ss} | ${level:uppercase=true} | ${logger} | ${message}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logfile"
      },
      {
        "logger": "Microsoft.*",
        "minLevel": "Warning",
        "writeTo": "logfile",
        "final": true
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=aws-0-us-west-2.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.fgueiiaozhsemuudxtsj;Password=&KSUVvafzC2W5PT;SslMode=Require;"
  }
}
